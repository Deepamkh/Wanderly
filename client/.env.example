# Copy to client/.env (local) or add as environment variables on your host (e.g. Render).
# These are read at BUILD time, so redeploy after changing them.

# Google reviews: easiest is GOOGLE_MAPS_API_KEY in server/.env (no rebuild needed).
# Alternatively set it here at build time. Restrict the key to your website's domains.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: use a different map tile server for the "Around you" map.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
