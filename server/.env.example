# ---------- Server ----------
PORT=5000
# Identify your app to OpenStreetMap / Wikimedia (required by their usage policies)
USER_AGENT=Wanderly/1.0 (open-source travel app; contact: you@example.com)

# ---------- Open data endpoints (all free, no API keys) ----------
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Overpass servers for nearby places. Leave unset to use the built-in list of 4 public mirrors
# (the server falls back between them automatically). Set it only to put your own instance first:
# OVERPASS_URLS=https://my-overpass.example.com/api/interpreter,https://overpass-api.de/api/interpreter

# ---------- AI trip planner ----------
# ollama  -> free, local, open-source models (default)  https://ollama.com
# openai  -> any OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, Groq/OpenRouter free tiers)
# none    -> skip the LLM and always use the built-in smart planner
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Only used when LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instruct
